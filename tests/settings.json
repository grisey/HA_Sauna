{
  "schema_version": 1,
  "description": "Exclusive defaults for test infrastructure and synthetic input data. Product settings are read from the product catalogue; independent acceptance criteria stay in their tests.",
  "runner": {
    "operating_system": "ubuntu-latest",
    "python_core": "3.13",
    "python_ha": "3.14.2",
    "prettier": "3.6.2",
    "ruff": "0.17.0",
    "artifact_retention_days": 7,
    "detector_replay_progress_s": 30,
    "ui_base_ref": "origin/codex/sauna-development"
  },
  "browser": {
    "engine": "chromium",
    "headless": true,
    "device_scale_factor": 2,
